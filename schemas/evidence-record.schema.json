{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pui89.github.io/schemas/evidence-record.schema.json",
  "title": "PUI89 EIPS Evidence Record",
  "description": "Metadata-only record for one individual video or dataset asset. Does not grant rights or approve use.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "product_ids",
    "asset_url",
    "publisher",
    "origin",
    "licence",
    "permissions",
    "link_status",
    "integrity_status",
    "review_status",
    "created_at",
    "updated_at",
    "history"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "pattern": "^P89-EV-[A-Z0-9-]{6,40}$"
    },
    "product_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "coconut-harvest-ai",
          "sentinel",
          "ai-home",
          "ai-nomad",
          "ai-robot-car",
          "easyrider-ai-scooter"
        ]
      }
    },
    "library_purposes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "website",
          "research",
          "validation"
        ]
      }
    },
    "asset_url": {
      "type": "string",
      "format": "uri"
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "identity_status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "website": {
          "type": "string",
          "format": "uri"
        },
        "identity_status": {
          "enum": [
            "verified",
            "unverified",
            "conflicting"
          ]
        },
        "evidence_reference": {
          "type": "string"
        }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "country_or_region",
        "status"
      ],
      "properties": {
        "country_or_region": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "verified",
            "pending",
            "conflicting",
            "rejected"
          ]
        },
        "evidence_reference": {
          "type": "string"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "licence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "terms_url",
        "status",
        "checked_at"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "terms_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "status": {
          "enum": [
            "verified",
            "pending",
            "conflicting",
            "rejected"
          ]
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "snapshot_reference": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "website",
        "research",
        "ai_training",
        "commercial",
        "redistribution"
      ],
      "properties": {
        "website": {
          "$ref": "#/$defs/permission"
        },
        "research": {
          "$ref": "#/$defs/permission"
        },
        "ai_training": {
          "$ref": "#/$defs/permission"
        },
        "commercial": {
          "$ref": "#/$defs/permission"
        },
        "redistribution": {
          "$ref": "#/$defs/permission"
        }
      }
    },
    "link_status": {
      "enum": [
        "unchecked",
        "working",
        "redirected",
        "broken",
        "blocked",
        "suspicious"
      ]
    },
    "canonical_url": {
      "type": "string",
      "format": "uri"
    },
    "integrity_status": {
      "enum": [
        "unchecked",
        "unchanged",
        "changed",
        "suspicious"
      ]
    },
    "review_status": {
      "enum": [
        "discovered",
        "pending_review",
        "approved_limited",
        "rejected",
        "quarantined"
      ]
    },
    "approved_uses": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "website",
          "research",
          "ai_training",
          "commercial",
          "redistribution"
        ]
      }
    },
    "technical_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "modalities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "privacy_review": {
      "enum": [
        "not_reviewed",
        "clear_for_intended_use",
        "restrictions_present",
        "unclear",
        "rejected"
      ]
    },
    "quality_assessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relevance": {
          "enum": [
            "high",
            "medium",
            "low",
            "unassessed"
          ]
        },
        "visual_quality": {
          "enum": [
            "high",
            "medium",
            "low",
            "unassessed"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "reviewer_notes": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/historyEntry"
      }
    },
    "duplicate_of": {
      "type": "string"
    }
  },
  "$defs": {
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "allowed",
            "prohibited",
            "unclear",
            "not_assessed"
          ]
        },
        "evidence_reference": {
          "type": "string"
        },
        "conditions": {
          "type": "string"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "historyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp",
        "action",
        "reason"
      ],
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "actor": {
          "type": "string"
        },
        "action": {
          "enum": [
            "created",
            "reviewed",
            "approved",
            "restricted",
            "rejected",
            "quarantined",
            "link_checked",
            "licence_changed",
            "metadata_changed",
            "restored"
          ]
        },
        "reason": {
          "type": "string"
        },
        "field_changes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "old_value",
              "new_value"
            ],
            "properties": {
              "field": {
                "type": "string"
              },
              "old_value": {},
              "new_value": {}
            }
          }
        },
        "evidence_reference": {
          "type": "string"
        }
      }
    }
  }
}
